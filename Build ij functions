-- Built-in Functions in SQL

CREATE TABLE Student (
    ID INT,
    Name VARCHAR(50),
    Mark INT,
    Department VARCHAR(30)
);

INSERT INTO Student VALUES
(1, 'Arun', 85, 'AIML'),
(2, 'Priya', 75, 'CSE'),
(3, 'Kumar', 60, 'IT'),
(4, 'Anu', 90, 'AIML');

-- 1. Aggregate Functions
SELECT COUNT(*) AS Total_Students FROM Student;

SELECT MAX(Mark) AS Highest_Mark FROM Student;

SELECT MIN(Mark) AS Lowest_Mark FROM Student;

SELECT AVG(Mark) AS Average_Mark FROM Student;

SELECT SUM(Mark) AS Total_Marks FROM Student;

-- 2. String Functions
SELECT UPPER(Name) AS Upper_Name FROM Student;

SELECT LOWER(Name) AS Lower_Name FROM Student;

-- 3. Numeric Function
SELECT ROUND(AVG(Mark), 2) AS Average_Mark
FROM Student;
