-- AND
SELECT * FROM Student
WHERE Department = 'AIML' AND Mark > 80;

-- OR
SELECT * FROM Student
WHERE Department = 'AIML' OR Mark > 80;

-- NOT
SELECT * FROM Student
WHERE NOT Department = 'CSE';
